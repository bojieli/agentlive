{
  "name": "agentlive-workspace",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=26.8.1 <27"
  },
  "scripts": {
    "build": "tsc -b && node scripts/build-web.mjs",
    "typecheck": "tsc -b --pretty false && node scripts/build-web.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "probe:agents": "node scripts/probe-agents.mjs",
    "probe:release": "node scripts/probe-release-flow.mjs",
    "check": "pnpm format:check && pnpm docs:check && pnpm typecheck && pnpm test",
    "docs:check": "node scripts/check-docs-links.mjs",
    "format": "prettier --write apps packages tests scripts packaging *.json *.ts *.yaml .github/workflows/*.yml",
    "format:check": "prettier --check apps packages tests scripts packaging *.json *.ts *.yaml .github/workflows/*.yml",
    "agentlive": "node packages/cli/dist/main.js",
    "package:build": "pnpm build && node scripts/build-package.mjs",
    "package:verify": "pnpm package:build && node scripts/probe-package.mjs",
    "package:lock": "pnpm build && node scripts/build-package.mjs --update-lock"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@types/node": "26.5.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
